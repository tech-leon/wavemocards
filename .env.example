# ===========================================
# Wavemocards Next.js - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values
# cp .env.example .env.local

# ----- App -----
# The public URL of your application
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ----- Supabase -----
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----- WorkOS AuthKit -----
# Get these from: https://dashboard.workos.com/
WORKOS_API_KEY=sk_live_xxxxx
WORKOS_CLIENT_ID=client_xxxxx

# A random string of at least 32 characters used to encrypt the cookie
# Generate one with: openssl rand -hex 32
WORKOS_COOKIE_PASSWORD=your-cookie-password-at-least-32-chars

# The callback URL for WorkOS authentication
# Must match the redirect URI configured in WorkOS Dashboard
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://your-domain.com/api/auth/callback

# ----- Vercel Analytics export -----
# Only needed to run the weekly /api/analytics/export cron.
# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>`
# Generate one with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Vercel API token with read access to the project's Web Analytics
# Create at: https://vercel.com/account/settings/tokens
VERCEL_API_TOKEN=your-vercel-api-token

# Project and team IDs, from the Vercel project settings page
VERCEL_ANALYTICS_PROJECT_ID=prj_xxxxx
VERCEL_ANALYTICS_TEAM_ID=team_xxxxx
